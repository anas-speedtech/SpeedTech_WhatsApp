# Copy this file to .env and fill in. NEVER commit .env or paste keys in chat/screenshots.
PORT=3000
BRAND_NAME=YourBrand
JWT_SECRET=change-me-to-a-long-random-string
# Needed to register as a reseller (buyers register without it)
RESELLER_SIGNUP_CODE=change-me

# Platform owner. Seeded on first boot, never through the sign-up form.
# Leave ADMIN_EMAIL empty to run without an admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform owner

# Helo / VivaConnect WhatsApp API. Docs: https://docs.helo.ai/helo-whatsapp
# Leave these empty to run the panel fully simulated (no messages are sent).
# UAT (sandbox): https://uat-wabaapp.helo.ai:8058   (as published in the docs)
# Production:    https://wabaapp.helo.ai
#
# NOTE (checked 2026-09-29): the published UAT host is not serving. Port 8058 refuses
# TCP connections, and port 443 answers but returns HTTP 500 for every path, with
# "TypeError: response.header is not a function" for POST and "...reading 'path'" under
# /v1. That is a server-side fault on Helo's side, reported to them. Until they confirm
# a working UAT, point this at production and test from a network that can reach it.
HELO_BASE_URL=
HELO_USER_ID=
# Authenticate with EITHER an API key OR a password. If both are set, the key wins.
# Accounts without an API key (no Generate button in the panel) use the password.
HELO_API_KEY=
HELO_PASSWORD=
# The password sign-in endpoint is not published in the docs, so its path and field
# names are configurable. These defaults are a best guess: if sign-in returns 404, set
# the correct values from the "Sign in with userName & Password" doc.
HELO_SIGNIN_PATH=/user/sign-in-user
HELO_SIGNIN_USER_FIELD=userName
HELO_SIGNIN_PASS_FIELD=password
# The WhatsApp number messages are sent FROM. Mandatory for real sends: Helo rejects a
# message without a valid sender. Digits only, with country code, no "+".
HELO_FROM=
# Optional. If empty the first active WhatsApp Business account is discovered
# automatically via /business/getAllWabas.
HELO_WABA_ID=
# How many single-send requests may be in flight at once. Helo's single-send endpoint
# takes one recipient per call, so a campaign of N buyers is N requests. Capped at 20.
HELO_BATCH_SIZE=5
# Meta requires a consent record for messages outside the 24h customer-service
# window. Set false only if your Helo account handles consent differently.
HELO_CHECK_CONSENT=true

# UPI checkout (self-hosted, no payment gateway account needed). Resellers scan a QR or
# tap a upi:// deep link, then confirm; the panel credits their wallet instantly. Set
# UPI_VPA to the UPI ID that should receive payments. Leave it blank to run the flow in
# simulated mode (no QR/link is shown; purchases are still recorded for reconciliation).
UPI_VPA=
UPI_PAYEE_NAME=
